index 68f0ef9..d77f3e0 100644
--- a/esp32/components/muse/boards/board_m5stack_stopwatch.c
+++ b/esp32/components/muse/boards/board_m5stack_stopwatch.c
@@ -1117,7 +1117,30 @@ static const muse_board_t s_board = {
 };
 
 /* Home Link's app_main starts Muse with this board (main/main.c). */
+#if CONFIG_MUSE_EVEN_BRIDGE
+static esp_err_t bridge_init(void)
+{
+    ESP_RETURN_ON_ERROR(init(), TAG, "bridge board init");
+    /* G2 supplies text. Keep the codec/microphone rail and I2S pins parked
+     * without allocating the duplex I2S DMA buffers or starting capture. */
+    codec_power(false);
+    return ESP_OK;
+}
+#endif
+
 const muse_board_t *muse_board_get(void)
 {
+#if CONFIG_MUSE_EVEN_BRIDGE
+    /* Preserve the display, physical pairing key and power controls while
+     * using muse_app's existing display-only startup path. */
+    static muse_board_t text_board;
+    text_board = s_board;
+    text_board.init = bridge_init;
+    text_board.audio_init = NULL;
+    text_board.audio_power = NULL;
+    text_board.codec_power = NULL;
+    return &text_board;
+#else
     return &s_board;
+#endif
 }
